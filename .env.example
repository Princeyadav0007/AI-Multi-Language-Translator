# Rename this file to .env
# No paid API keys are required for the default setup
# (deep-translator + gTTS + LanguageTool public API are free).
# This file is kept for future upgrades (e.g. if you switch to a paid
# translation API like Google Cloud Translate or DeepL).

GOOGLE_CLOUD_API_KEY=
DEEPL_API_KEY=

APP_NAME=AI Powered Multi-Language Translator
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=en
